{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixelperfect.studio/schemas/asset-record.schema.json",
  "title": "Asset Record",
  "type": "object",
  "required": [
    "asset_id",
    "kind",
    "sha256",
    "filename",
    "mime_type",
    "dimensions",
    "provenance",
    "rights_status",
    "validation_status"
  ],
  "properties": {
    "asset_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "image",
        "font",
        "icon",
        "svg",
        "texture",
        "mask",
        "render",
        "other"
      ]
    },
    "filename": {
      "type": "string"
    },
    "mime_type": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "perceptual_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "dimensions": {
      "type": "object",
      "required": [
        "width_px",
        "height_px"
      ],
      "properties": {
        "width_px": {
          "type": "integer",
          "minimum": 1
        },
        "height_px": {
          "type": "integer",
          "minimum": 1
        },
        "alpha": {
          "type": "boolean"
        },
        "colour_space": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "user-provided",
            "source",
            "generated",
            "code"
          ]
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "creator": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "generation_prompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent_asset_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "rights_status": {
      "enum": [
        "verified",
        "restricted",
        "unknown",
        "prohibited"
      ]
    },
    "license": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "attribution": {
          "type": [
            "string",
            "null"
          ]
        },
        "permitted_use": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "restrictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "layer_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "variant_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "processing_history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "validation_status": {
      "enum": [
        "pending",
        "inspected",
        "approved",
        "rejected"
      ]
    },
    "source_extraction": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "parent_source_sha256",
        "source_bbox_px",
        "mask_method",
        "output_sha256"
      ],
      "properties": {
        "parent_source_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "source_bbox_px": {
          "type": "object",
          "required": [
            "x_min",
            "y_min",
            "x_max",
            "y_max"
          ],
          "properties": {
            "x_min": {
              "type": "number"
            },
            "y_min": {
              "type": "number"
            },
            "x_max": {
              "type": "number"
            },
            "y_max": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "mask_method": {
          "type": "string",
          "minLength": 1
        },
        "mask_asset_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "antialiasing_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "edge_feather_px": {
          "type": "number",
          "minimum": 0
        },
        "output_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      },
      "additionalProperties": true
    },
    "font_match": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "recovery_method": {
          "enum": [
            "EXACT_FONT",
            "SOURCE_GLYPH_RASTER",
            "SOURCE_GLYPH_SVG",
            "APPROVED_SUBSTITUTE",
            "UNKNOWN"
          ]
        },
        "font_family": {
          "type": [
            "string",
            "null"
          ]
        },
        "font_verified": {
          "type": "boolean"
        },
        "glyphs_extracted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "comparison_evidence": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
